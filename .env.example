# Copy this file to .env and fill in your own values before running in production.

# Port the app listens on
PORT=3000

# Secret used to sign session cookies - set this to a long random string in production.
SESSION_SECRET=change-this-to-a-long-random-string

# The very first time the app starts with an empty database, it creates one admin
# account using these values. Change the PIN immediately after logging in
# (Account tab), or just edit these before the first run.
ADMIN_NAME=Admin
ADMIN_PIN=1234
